<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.baobi.artboardgrid" ExtensionBundleVersion="2.1.0" ExtensionBundleName="Tao Artboard va Luoi Bao Bi">
